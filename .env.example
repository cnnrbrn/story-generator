# Copy to .env and fill in. .env is gitignored and never committed.

# --- LLM providers (cheap defaults: OpenAI + DeepSeek; both OpenAI-compatible) ---
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=   # optional — only needed if GENERATOR_MODEL is a claude-* id
TAVILY_API_KEY=

# Default generator model (DeepSeek). deepseek-v4-flash = cheapest,
# deepseek-v4-pro = better quality. claude-* ids route to Anthropic (pricey).
# Uncomment to override the default (deepseek-v4-pro):
# GENERATOR_MODEL=deepseek-v4-flash

# --- Database ---
# For running the app/scripts ON YOUR MACHINE (the venv). Points at the dev DB
# that docker-compose publishes on host port 5433.
# NOTE: the Docker `api` container does NOT use this — compose sets its own
# DATABASE_URL pointing at the internal db service (db:5432).
DATABASE_URL=postgresql+psycopg://storygen:storygen@localhost:5433/storygen

# --- Background worker (added in a later step) ---
# REDIS_URL=redis://localhost:6379/0
